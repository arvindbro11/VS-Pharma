{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "VS Pharma — run website",
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "type": "node",
      "request": "launch",
      "name": "VS Pharma — watch mode",
      "runtimeArgs": ["--watch"],
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
